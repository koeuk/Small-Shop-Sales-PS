# Local classroom demo. Never expose demo mode to the public internet.
APP_MODE=demo
DEMO_EMAIL=admin@smallshop.local
DEMO_PASSWORD=shopdemo2026
SHOP_TIMEZONE=Asia/Phnom_Penh
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Defaults to backend/data/shop.db. Absolute SQLite paths also work.
# DATABASE_URL=sqlite:////absolute/path/to/shop.db
# ARTIFACT_DIR=/absolute/path/to/model-artifacts

# For Supabase: apply supabase/schema.sql, create an Auth user, then set:
# APP_MODE=supabase
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=require
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# ADMIN_USER_ID=AUTH_USER_UUID
